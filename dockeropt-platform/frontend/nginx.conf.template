server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # DNS interne de Docker pour résoudre dynamiquement les noms d'hôtes
    resolver 127.0.0.11 valid=30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 512;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /api/ {
        # BACKEND_UPSTREAM est injecté au démarrage du conteneur (et non au
        # build, contrairement à VITE_API_BASE) via le mécanisme de templates
        # natif de l'image nginx officielle (/etc/nginx/templates/*.template
        # -> envsubst -> /etc/nginx/conf.d/*.conf), voir Dockerfile et
        # docker-compose.yml (environment.BACKEND_UPSTREAM du service
        # frontend, dérivé de BACKEND_HOST_PORT). Ainsi, changer le port du
        # backend dans .env suffit : plus besoin de toucher ce fichier.
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass $backend_upstream;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 10s;
        proxy_send_timeout 185s;
        proxy_read_timeout 185s;
    }
}